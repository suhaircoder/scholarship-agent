# Copy to .env and fill in only the channels you use.
# The agent runs without these. Digests are still written to data/digests/.

# Optional OpenAI-compatible classifier. Leave blank to use the built-in rules.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Email digests (STARTTLS, usually port 587)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Telegram digests. Chat ids can also be set per person in config/users/*.yaml
TELEGRAM_BOT_TOKEN=
ME_TELEGRAM_CHAT_ID=
SISTER_TELEGRAM_CHAT_ID=

# Optional inbox addresses, used when delivery.email.enabled is true
ME_EMAIL=
SISTER_EMAIL=
